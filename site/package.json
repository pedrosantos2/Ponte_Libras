{
  "name": "site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "paridade": "vite --config vite.paridade.config.ts",
    "testar": "node --experimental-strip-types --no-warnings testes/moderacao.ts && node --experimental-strip-types --no-warnings testes/dicionario.ts",
    "dicionario": "node scripts/gerar-dicionario.mjs",
    "predev": "node scripts/gerar-dicionario.mjs --se-faltar",
    "prebuild": "node scripts/gerar-dicionario.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "dictionary-pt": "^4.0.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
