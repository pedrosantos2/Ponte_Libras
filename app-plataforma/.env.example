# Copie para .env.local e preencha com os dados do seu projeto no Supabase
# (Project Settings → API). O .env.local não vai para o Git.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# A chave "anon" (pública). NUNCA coloque aqui a chave "service_role".
VITE_SUPABASE_ANON_KEY=sua-chave-publica-anon

# Mude para true depois de ativar o Google em Authentication → Providers
# (o passo a passo está no README.md). Até lá, o botão fica escondido.
VITE_LOGIN_GOOGLE=false

# Endereço da landing, para o link "Conheça o projeto" do rodapé
VITE_LANDING_URL=http://localhost:5173
